# P-CAUSAL-002: one matched GDN2 FutureSeed causal gate on official Maze30.
CUDA_VISIBLE_DEVICES=0
SKIP_SETUP=1
REQUIRE_CLEAN_SOURCE=1
SOURCE_SNAPSHOT_MODE=lean
PERSIST_ROOT=/huyang2/double-loop
PYTHON_BIN=/opt/conda/bin/python
PYTHON_EXTRA_PATH=/huyang2/double-loop/.cache/fla-active:/huyang2/double-loop/.cache/python-extra-pylib
FLA_DISABLE_BACKEND_DISPATCH=1
FLA_CONV_BACKEND=triton
FLA_EXPECTED_SOURCE_SHA=9c8e42e762fce087c27b673af4922795d9edb85e
FLA_STRICT_OFFICIAL=1

RWKV_MAZE_DATA_DIR=/huyang2/double-loop/official_eqr_compare/eqr-clean/data/maze-30x30-unique-1k
BACKBONE=gdn2
GDN_MODE=chunk
GDN_EXPAND_V=1.0
GDN_USE_SHORT_CONV=1
GDN_CONV_SIZE=4
RWKV_KERNEL=auto
D_MODEL=128
LAYERS=6
HEADS=4
HEAD_DIM=32
CHANNEL_MULT=4
L_CYCLES=2
MAX_LOOPS=2
EVAL_LOOPS=5
LAMBDA=0.95
FUTURE_SEED_DECAY=0.0
FUTURE_SEED_UPDATE=fixed
FORWARD_DTYPE=bfloat16

RWKV_MAZE_STEPS=300
RWKV_MAZE_BATCH=32
RWKV_MAZE_EVAL_N=128
RWKV_MAZE_EVAL_BATCH=16
RWKV_MAZE_PATH_WEIGHT=1.0
RWKV_MAZE_PATH_BINARY_WEIGHT=0.0
RWKV_MAZE_PATH_BUDGET_WEIGHT=0.0
RWKV_MAZE_PATH_COUNT_WEIGHT=0.0
LOOP_LOSS=all
LR=3e-4
WEIGHT_DECAY=0.1
GRAD_CLIP=1.0
SEED=52
LOG_EVERY=100
RWKV_MAZE_VIZ_CASES=12
