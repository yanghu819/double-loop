# P-CAUSAL-004: upstream Zoology MQAR directionality gate.
CUDA_VISIBLE_DEVICES=0
SKIP_SETUP=1
REQUIRE_CLEAN_SOURCE=1
SOURCE_SNAPSHOT_MODE=lean
PERSIST_ROOT=/huyang2/double-loop
PYTHON_BIN=/opt/conda/bin/python
PYTHON_EXTRA_PATH=/huyang2/double-loop/.cache/fla-active:/huyang2/double-loop/.cache/python-extra-pylib
FLA_DISABLE_BACKEND_DISPATCH=1
FLA_CONV_BACKEND=triton
FLA_EXPECTED_SOURCE_SHA=9c8e42e762fce087c27b673af4922795d9edb85e

ZOOLOGY_ROOT=/huyang2/double-loop/repos/zoology-official
ZOOLOGY_SHA=1ad20d193b6113cae1e8f3c655c300d7b4b3f4bb
MQAR_STEPS=1000
MQAR_BATCH=128
MQAR_EVAL_N=1024
MQAR_EVAL_BATCH=128
MQAR_SEQ_LEN=128
MQAR_PAIRS=8
MQAR_VOCAB_SIZE=8192
D_MODEL=128
LAYERS=4
HEADS=4
HEAD_DIM=32
CHANNEL_MULT=4
MAX_LOOPS=2
EVAL_LOOPS=4
LAMBDA=0.95
GDN_MODE=chunk
GDN_EXPAND_V=1.0
GDN_CONV_SIZE=4
FORWARD_DTYPE=bfloat16
LR=1e-3
WEIGHT_DECAY=0.1
GRAD_CLIP=0.0
SEED=52
LOG_EVERY=100
MQAR_VIZ_CASES=8
MQAR_CARRIER_KILL_STEP=500
MQAR_CARRIER_MIN_PAST_ACC=0.50
