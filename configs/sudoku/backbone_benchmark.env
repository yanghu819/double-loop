# State-matched four-backbone comparison. Parameters and runtime are measured, not padded.
BENCHMARK_STEPS=500
BENCHMARK_EASY_STEPS=100

SUDOKU_SIZE=9
HOLE_PATTERN=random
OFFICIAL_SUDOKU_DATA_DIR=/huyang2/double-loop/data/sudoku-extreme-full
OFFICIAL_SUDOKU_TRAIN_SPLIT=train
OFFICIAL_SUDOKU_EVAL_SPLIT=test
OFFICIAL_EVAL_BLANK_RANGES=46-50,51-55,56-64
EVAL_HOLES=53
EVAL_HOLES_LIST=53

D_MODEL=192
LAYERS=10
HEADS=6
HEAD_DIM=32
CHANNEL_MULT=4
L_CYCLES=2
MAX_LOOPS=5

FULL_BATCH=32
GRAD_ACCUM_STEPS=4
FULL_EVAL_N=512
FORWARD_DTYPE=bfloat16
LR=0.0015
WEIGHT_DECAY=0.001
OPTIMIZER_CONTRACT=rwkv7_decay_groups
SHARED_SHELL_INIT_SEED=52
BLANK_LOSS_WEIGHT=8
LOOP_LOSS=all

FUTURE_SEED_SCALE=1
FUTURE_SEED_DECAY=0
FUTURE_SEED_UPDATE=fixed
FUTURE_SEED_NORM_MODE=unit
LOOP_UPDATE_MODE=fixed
LOOP_UPDATE_GATE_INIT=0.95

GDN_MODE=chunk
GDN_EXPAND_V=1
GDN_PROGRESSIVE_BASE_EXPAND_V=0
GDN_USE_SHORT_CONV=1
GDN_CONV_SIZE=4
GDN_ALLOW_NEG_EIGVAL=0

NOISE_SCALE=0
ROLLOUT_NOISE_SCALE=0
LOOP_FEEDBACK_SCALE=0
LOOP_TIME_SCALE=0
SCRATCH_MODE=none
SCRATCH_NOISE_SCALE=0
SCRATCH_GAUSS_WEIGHT=0
HIDDEN_AGG_NOISE_SCALE=0
EXACT_MARGIN_WEIGHT=0

FULL_ROLLOUT_KS=
FULL_LOG_EVERY=100
CASE_BANK_N=4
CASE_BANK_EVAL_N=256
CASE_BANK_LOOP_VALUES=1,2,3,4,5
SEED=52
