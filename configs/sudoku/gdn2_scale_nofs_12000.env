# P-CAUSAL-001 matched long no-FutureSeed control.
# Every scientific variable comes from the completed P-SCALE-037 trajectory;
# only the FutureSeed contribution is disabled.
CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=gdn2_scale.env
source "$CONFIG_DIR/gdn2_scale.env"

FUTURE_SEED_SCALE=0

