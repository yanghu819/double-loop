# P-GDN3-071: second-order Momentum DeltaNet plus native full-state FutureSeed.
SUDOKU_SIZE=9
HOLE_PATTERN=random
OFFICIAL_SUDOKU_DATA_DIR=/huyang2/double-loop/data/sudoku-extreme-full
OFFICIAL_SUDOKU_TRAIN_SPLIT=train
OFFICIAL_SUDOKU_EVAL_SPLIT=test
OFFICIAL_EVAL_BLANK_RANGES=46-50,51-55,56-60,61-64
HOLE_STAGES=46-50:500,51-55:3500,51-60:4000,51-64:4000
EVAL_HOLES=60
EVAL_HOLES_LIST=50,53,58,64

BACKBONE=momentum
FLA_STRICT_OFFICIAL=1
FLA_DISABLE_BACKEND_DISPATCH=1
FLA_CONV_BACKEND=triton
FLA_USE_CUDA_GRAPH=0
GDN_MODE=chunk
GDN_EXPAND_V=1
GDN_PROGRESSIVE_BASE_EXPAND_V=0
GDN_USE_SHORT_CONV=1
GDN_CONV_SIZE=4
GDN_ALLOW_NEG_EIGVAL=0

MDN_REPO_URL=https://github.com/HuuYuLong/MomentumDeltaNet.git
MDN_EXPECTED_SHA=c6e77fa261fb0c002fae1a14b6209a5b28d2edc9

D_MODEL=192
LAYERS=10
HEADS=6
HEAD_DIM=32
CHANNEL_MULT=4
L_CYCLES=2
MAX_LOOPS=5

FULL_STEPS=12000
FULL_BATCH=32
GRAD_ACCUM_STEPS=4
FULL_EVAL_N=512
FORWARD_DTYPE=bfloat16
LR=0.0015
WEIGHT_DECAY=0.001
OPTIMIZER_CONTRACT=rwkv7_decay_groups
SHARED_SHELL_INIT_SEED=52
BLANK_LOSS_WEIGHT=8
LOOP_LOSS=all

FUTURE_SEED_SCALE=1
FUTURE_SEED_DECAY=0
FUTURE_SEED_UPDATE=fixed
FUTURE_SEED_NORM_MODE=unit
FUTURE_SEED_GATE_MODE=head
FUTURE_SEED_SCOPE=layer
FUTURE_SEED_READOUT_HOP=0
FUTURE_SEED_CONTENT_MODE=terminal
FUTURE_SEED_GRADIENT_MODE=canonical
MOMENTUM_FUTURE_SEED_TRANSPORT=full_state
LOOP_UPDATE_MODE=fixed
LOOP_UPDATE_GATE_INIT=0.95

NOISE_SCALE=0
ROLLOUT_NOISE_SCALE=0
LOOP_FEEDBACK_SCALE=0
LOOP_TIME_SCALE=0
SCRATCH_MODE=none
SCRATCH_NOISE_SCALE=0
SCRATCH_GAUSS_WEIGHT=0
HIDDEN_AGG_NOISE_SCALE=0
EXACT_MARGIN_WEIGHT=0

FULL_ROLLOUT_KS=
FULL_LOG_EVERY=100
EVAL_CHECKPOINT_STEPS=500,1000,3000,6000,9000,12000
EVAL_CHECKPOINT_HOLES_LIST=50,53,58,64
SAVE_TRAIN_CHECKPOINT_EVERY=100
CASE_BANK_N=4
CASE_BANK_EVAL_N=256
CASE_BANK_LOOP_VALUES=1,2,3,4,5
SEED=52
