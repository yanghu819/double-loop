+class FutureSeedMixer(nn.Module):
+    def __init__(self, hidden_size: int, rms_norm_eps: float, scale: float, gate_bias: float) -> None:
+        super().__init__()
+        self.future_seed_scale = float(scale)
+        self.norm_eps = float(rms_norm_eps)
+        self.gate_logit = nn.Parameter(torch.tensor(float(gate_bias)))
+        self.proj = CastedLinear(hidden_size, hidden_size, bias=False)
+        with torch.no_grad():
+            self.proj.weight.zero_()
+            idx = torch.arange(hidden_size)
+            self.proj.weight[idx, idx] = 1.0
+
+    def forward(self, target: torch.Tensor, seed: torch.Tensor) -> torch.Tensor:
+        scale = float(self.future_seed_scale)
+        if scale == 0.0:
+            return target
+        seeded = self.proj(rms_norm(seed, variance_epsilon=self.norm_eps)).to(target.dtype)
+        gate = torch.sigmoid(self.gate_logit.to(torch.float32)).to(target.dtype) * scale
+        return target + gate * seeded
+
+
+class LearnedStateGate(nn.Module):
+    def __init__(self, hidden_size: int, rms_norm_eps: float, gate_bias: float) -> None:
+        super().__init__()
+        self.norm_eps = float(rms_norm_eps)
+        self.gate = CastedLinear(hidden_size, hidden_size, bias=True)
+        with torch.no_grad():
+            self.gate.weight.zero_()
+            self.gate.bias.fill_(float(gate_bias))
+
+    def forward(self, previous: torch.Tensor, proposed: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+        delta = proposed - previous
+        gate = torch.sigmoid(self.gate(rms_norm(delta, variance_epsilon=self.norm_eps)).to(torch.float32)).to(proposed.dtype)
+        return previous + gate * delta, gate
+
+
+class StateCompetitionMixer(nn.Module):
+    def __init__(self, config: EqRConfig, context_mode: str = "self") -> None:
+        super().__init__()
+        self.norm_eps = float(config.rms_norm_eps)
+        self.context_mode = str(context_mode).lower()
+        if self.context_mode not in {"self", "cross", "conf"}:
+            raise ValueError(f"Unknown state competition context_mode '{context_mode}'")
+        self.cross_proj = CastedLinear(config.hidden_size * 4, config.hidden_size, bias=False) if self.context_mode in {"cross", "conf"} else None
+        self.context_attn = Attention(
+            hidden_size=config.hidden_size,
+            head_dim=config.hidden_size // config.num_heads,
+            num_heads=config.num_heads,
+            num_key_value_heads=config.num_heads,
+            causal=False,
+        )
+        self.score = CastedLinear(config.hidden_size, 1, bias=False)
+        self.conf_score = CastedLinear(6, 3, bias=True) if self.context_mode == "conf" else None
+        bias = [0.0, 0.0, 0.0] if self.context_mode in {"cross", "conf"} else [-2.0, 2.0, -2.0]
+        self.score_bias = nn.Parameter(torch.tensor(bias, dtype=torch.float32))
+        self.latest_candidate_stats: Dict[str, float] = {}
+        self.latest_context: Optional[torch.Tensor] = None
+        with torch.no_grad():
+            self.score.weight.zero_()
+            if self.conf_score is not None:
+                self.conf_score.weight.zero_()
+                if self.conf_score.bias is not None:
+                    self.conf_score.bias.zero_()
+
+    def _confidence_bias(
+        self,
+        proposed: torch.Tensor,
+        context: torch.Tensor,
+        readout: Optional[nn.Module],
+        puzzle_emb_len: int,
+    ) -> Tuple[Optional[torch.Tensor], Dict[str, float]]:
+        if self.conf_score is None or readout is None:
+            return None, {}
+        offset = int(puzzle_emb_len)
+        proposed_board = proposed[:, offset:]
+        context_board = context[:, offset:]
+        if proposed_board.shape[1] == 0:
+            return None, {}
+        proposed_logits = readout(proposed_board).to(torch.float32)
+        context_logits = readout(context_board).to(torch.float32)
+        proposed_top2 = proposed_logits.topk(k=min(2, proposed_logits.shape[-1]), dim=-1).values
+        context_top2 = context_logits.topk(k=min(2, context_logits.shape[-1]), dim=-1).values
+        if proposed_top2.shape[-1] == 1:
+            proposed_margin = proposed_top2[..., 0]
+            context_margin = context_top2[..., 0]
+        else:
+            proposed_margin = proposed_top2[..., 0] - proposed_top2[..., 1]
+            context_margin = context_top2[..., 0] - context_top2[..., 1]
+        proposed_prob = proposed_logits.softmax(dim=-1)
+        context_prob = context_logits.softmax(dim=-1)
+        log_vocab = math.log(max(2, proposed_logits.shape[-1]))
+        proposed_entropy = -(proposed_prob * proposed_prob.clamp_min(1e-8).log()).sum(dim=-1) / log_vocab
+        context_entropy = -(context_prob * context_prob.clamp_min(1e-8).log()).sum(dim=-1) / log_vocab
+        disagreement = (proposed_prob - context_prob).abs().sum(dim=-1)
+        features = torch.stack(
+            (
+                torch.tanh(proposed_margin / 4.0),
+                torch.tanh(context_margin / 4.0),
+                torch.tanh((context_margin - proposed_margin) / 4.0),
+                proposed_entropy,
+                context_entropy,
+                disagreement,
+            ),
+            dim=-1,
+        ).to(proposed.dtype)
+        board_bias = self.conf_score(features).to(torch.float32)
+        if offset > 0:
+            pad = torch.zeros(
+                board_bias.shape[0],
+                offset,
+                board_bias.shape[-1],
+                dtype=board_bias.dtype,
+                device=board_bias.device,
+            )
+            bias = torch.cat((pad, board_bias), dim=1)
+        else:
+            bias = board_bias
+        with torch.no_grad():
+            stats = {
+                "state_compete_h_conf_bias_abs_mean": float(board_bias.abs().mean().detach().cpu()),
+                "state_compete_h_conf_bias_std": float(board_bias.std(unbiased=False).detach().cpu()),
+                "state_compete_h_conf_prop_margin": float(proposed_margin.mean().detach().cpu()),
+                "state_compete_h_conf_context_margin": float(context_margin.mean().detach().cpu()),
+                "state_compete_h_conf_margin_delta": float((context_margin - proposed_margin).mean().detach().cpu()),
+                "state_compete_h_conf_prop_entropy": float(proposed_entropy.mean().detach().cpu()),
+                "state_compete_h_conf_context_entropy": float(context_entropy.mean().detach().cpu()),
+                "state_compete_h_conf_disagreement": float(disagreement.mean().detach().cpu()),
+            }
+        return bias, stats
+
+    def forward(
+        self,
+        previous: torch.Tensor,
+        proposed: torch.Tensor,
+        readout: Optional[nn.Module] = None,
+        puzzle_emb_len: int = 0,
+        **kwargs: Any,
+    ) -> Tuple[torch.Tensor, torch.Tensor]:
+        if self.context_mode in {"cross", "conf"}:
+            previous_norm = rms_norm(previous, variance_epsilon=self.norm_eps)
+            proposed_norm = rms_norm(proposed, variance_epsilon=self.norm_eps)
+            cross_features = torch.cat(
+                (
+                    previous_norm,
+                    proposed_norm,
+                    proposed_norm - previous_norm,
+                    previous_norm * proposed_norm,
+                ),
+                dim=-1,
+            )
+            context_input = rms_norm(
+                proposed + self.cross_proj(cross_features).to(proposed.dtype),
+                variance_epsilon=self.norm_eps,
+            )
+        else:
+            context_input = proposed
+        context = rms_norm(
+            context_input + self.context_attn(hidden_states=context_input, **kwargs),
+            variance_epsilon=self.norm_eps,
+        )
+        self.latest_context = context
+        candidates = torch.stack((previous, proposed, context), dim=-2)
+        scores = self.score(rms_norm(candidates, variance_epsilon=self.norm_eps)).squeeze(-1).to(torch.float32)
+        scores = scores + self.score_bias.to(scores.device)
+        conf_bias, conf_stats = self._confidence_bias(proposed, context, readout, puzzle_emb_len)
+        if conf_bias is not None:
+            scores = scores + conf_bias
+        weights = torch.softmax(scores, dim=-1).to(proposed.dtype)
+        mixed = (weights.unsqueeze(-1) * candidates).sum(dim=-2)
+        with torch.no_grad():
+            self.latest_candidate_stats = {
+                "state_compete_h_context_minus_proposed_rms": float(
+                    (context - proposed).to(torch.float32).square().mean().sqrt().detach().cpu()
+                ),
+                "state_compete_h_proposed_minus_previous_rms": float(
+                    (proposed - previous).to(torch.float32).square().mean().sqrt().detach().cpu()
+                ),
+                **conf_stats,
+            }
+        return mixed, weights
+
+
+class DecisionBoundaryCalibrator(nn.Module):
+    def __init__(self, config: EqRConfig, budget_state: bool = False) -> None:
+        super().__init__()
+        self.token_id = int(config.decision_boundary_token_id)
+        self.scale = float(config.decision_boundary_scale)
+        self.budget_state = bool(budget_state)
+        feature_dim = 11
+        budget_dim = 9
+        hidden = max(16, min(64, config.hidden_size // 4))
+        self.norm = nn.LayerNorm(feature_dim)
+        self.net = nn.Sequential(
+            nn.Linear(feature_dim, hidden),
+            nn.SiLU(),
+            nn.Linear(hidden, 1),
+        )
+        self.budget_norm = nn.LayerNorm(budget_dim) if self.budget_state else None
+        self.budget_net = (
+            nn.Sequential(
+                nn.Linear(budget_dim, hidden),
+                nn.SiLU(),
+                nn.Linear(hidden, 1),
+            )
+            if self.budget_state
+            else None
+        )
+        self.latest_stats: Dict[str, float] = {}
+        with torch.no_grad():
+            nn.init.xavier_uniform_(self.net[0].weight)
+            self.net[0].bias.zero_()
+            nn.init.normal_(self.net[2].weight, mean=0.0, std=0.02)
+            self.net[2].bias.zero_()
+            if self.budget_net is not None:
+                nn.init.xavier_uniform_(self.budget_net[0].weight)
+                self.budget_net[0].bias.zero_()
+                nn.init.normal_(self.budget_net[2].weight, mean=0.0, std=0.02)
+                self.budget_net[2].bias.zero_()
+
+    def _target_features(self, logits: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+        logits_fp32 = logits.to(torch.float32)
+        vocab = logits_fp32.shape[-1]
+        token_id = self.token_id
+        if token_id < 0 or token_id >= vocab:
+            raise ValueError(f"decision_boundary_token_id {token_id} is outside vocab size {vocab}")
+        target = logits_fp32[..., token_id]
+        non_target = logits_fp32.clone()
+        non_target[..., token_id] = torch.finfo(logits_fp32.dtype).min
+        non_target_max = non_target.max(dim=-1).values
+        margin = target - non_target_max
+        prob = logits_fp32.softmax(dim=-1)
+        entropy = -(prob * prob.clamp_min(1e-8).log()).sum(dim=-1) / math.log(max(2, vocab))
+        return target, non_target_max, margin, entropy
+
+    def forward(
+        self,
+        logits: torch.Tensor,
+        previous_logits: torch.Tensor,
+        context_logits: Optional[torch.Tensor],
+        candidate_weights: Optional[torch.Tensor],
+        loop_index: Optional[torch.Tensor],
+    ) -> torch.Tensor:
+        if self.scale == 0.0:
+            self.latest_stats = {}
+            return logits
+        raw_target, _raw_non_target, raw_margin, raw_entropy = self._target_features(logits)
+        _prev_target, _prev_non_target, prev_margin, _prev_entropy = self._target_features(previous_logits)
+        if context_logits is None:
+            context_margin = raw_margin
+            context_entropy = raw_entropy
+            disagreement = torch.zeros_like(raw_margin)
+        else:
+            _context_target, _context_non_target, context_margin, context_entropy = self._target_features(context_logits)
+            disagreement = (
+                logits.to(torch.float32).softmax(dim=-1) - context_logits.to(torch.float32).softmax(dim=-1)
+            ).abs().sum(dim=-1)
+        if candidate_weights is None:
+            weight_features = torch.zeros(*raw_margin.shape, 3, dtype=torch.float32, device=logits.device)
+            weight_features[..., 1] = 1.0
+        else:
+            weight_features = candidate_weights.to(torch.float32)
+        if loop_index is None:
+            loop_feature = torch.zeros_like(raw_margin)
+        else:
+            loop_value = loop_index.to(device=logits.device, dtype=torch.float32).view(-1, 1)
+            loop_feature = torch.log1p(loop_value).expand_as(raw_margin) / 4.0
+        features = torch.cat(
+            (
+                torch.tanh(raw_margin[..., None] / 4.0),
+                torch.tanh(prev_margin[..., None] / 4.0),
+                torch.tanh(context_margin[..., None] / 4.0),
+                torch.tanh((context_margin - raw_margin)[..., None] / 4.0),
+                raw_entropy[..., None],
+                context_entropy[..., None],
+                disagreement[..., None],
+                weight_features,
+                loop_feature[..., None],
+            ),
+            dim=-1,
+        )
+        threshold = self.net(self.norm(features)).squeeze(-1).to(torch.float32) * self.scale
+        budget_shift = torch.zeros(logits.shape[0], 1, dtype=torch.float32, device=logits.device)
+        raw_prob = logits.to(torch.float32).softmax(dim=-1)
+        if self.budget_state and self.budget_net is not None and self.budget_norm is not None:
+            target_prob = raw_prob[..., self.token_id]
+            soft_path_frac = target_prob.mean(dim=-1)
+            raw_margin_mean = raw_margin.mean(dim=-1)
+            entropy_mean = raw_entropy.mean(dim=-1)
+            disagreement_mean = disagreement.mean(dim=-1)
+            if candidate_weights is None:
+                weight_mean = torch.zeros(raw_margin.shape[0], 3, dtype=torch.float32, device=logits.device)
+                weight_mean[:, 1] = 1.0
+            else:
+                weight_mean = candidate_weights.to(torch.float32).mean(dim=1)
+            loop_mean = loop_feature.mean(dim=-1)
+            budget_features = torch.cat(
+                (
+                    torch.tanh(raw_margin_mean[:, None] / 4.0),
+                    soft_path_frac[:, None],
+                    entropy_mean[:, None],
+                    disagreement_mean[:, None],
+                    weight_mean,
+                    loop_mean[:, None],
+                    torch.ones_like(loop_mean[:, None]),
+                ),
+                dim=-1,
+            )
+            budget_shift = self.budget_net(self.budget_norm(budget_features)).to(torch.float32) * self.scale
+            threshold = threshold + budget_shift
+        calibrated = logits.to(torch.float32).clone()
+        calibrated[..., self.token_id] = calibrated[..., self.token_id] - threshold
+        calibrated_margin = raw_margin - threshold
+        with torch.no_grad():
+            raw_pred = logits.to(torch.float32).argmax(dim=-1) == self.token_id
+            calibrated_pred = calibrated.argmax(dim=-1) == self.token_id
+            calibrated_prob = calibrated.softmax(dim=-1)
+            raw_soft_path_frac = raw_prob[..., self.token_id].mean()
+            calibrated_soft_path_frac = calibrated_prob[..., self.token_id].mean()
+            self.latest_stats = {
+                "state_boundary_threshold_mean": float(threshold.mean().detach().cpu()),
+                "state_boundary_threshold_abs_mean": float(threshold.abs().mean().detach().cpu()),
+                "state_boundary_threshold_std": float(threshold.std(unbiased=False).detach().cpu()),
+                "state_boundary_threshold_pos_frac": float((threshold > 0).to(torch.float32).mean().detach().cpu()),
+                "state_boundary_budget_shift_mean": float(budget_shift.mean().detach().cpu()),
+                "state_boundary_budget_shift_abs_mean": float(budget_shift.abs().mean().detach().cpu()),
+                "state_boundary_budget_shift_std": float(budget_shift.std(unbiased=False).detach().cpu()),
+                "state_boundary_budget_shift_pos_frac": float((budget_shift > 0).to(torch.float32).mean().detach().cpu()),
+                "state_boundary_raw_margin_mean": float(raw_margin.mean().detach().cpu()),
+                "state_boundary_calibrated_margin_mean": float(calibrated_margin.mean().detach().cpu()),
+                "state_boundary_margin_shift_mean": float((calibrated_margin - raw_margin).mean().detach().cpu()),
+                "state_boundary_raw_path_frac": float(raw_pred.to(torch.float32).mean().detach().cpu()),
+                "state_boundary_calibrated_path_frac": float(calibrated_pred.to(torch.float32).mean().detach().cpu()),
+                "state_boundary_raw_soft_path_frac": float(raw_soft_path_frac.detach().cpu()),
+                "state_boundary_calibrated_soft_path_frac": float(calibrated_soft_path_frac.detach().cpu()),
+                "state_boundary_soft_path_frac_delta": float((calibrated_soft_path_frac - raw_soft_path_frac).detach().cpu()),
+                "state_boundary_prune_flip_frac": float((raw_pred & ~calibrated_pred).to(torch.float32).mean().detach().cpu()),
+                "state_boundary_add_flip_frac": float((~raw_pred & calibrated_pred).to(torch.float32).mean().detach().cpu()),
+                "state_boundary_loop_feature": float(loop_feature.mean().detach().cpu()),
+            }
+        return calibrated.to(logits.dtype)
+
+
+class FeatureNoiseBuffer(nn.Module):
+    def __init__(self, hidden_size: int, max_size: int, max_add: int) -> None:
+        super().__init__()
+        self.hidden_size = int(hidden_size)
+        self.max_size = max(0, int(max_size))
+        self.max_add = max(0, int(max_add))
+        self.register_buffer("features", torch.empty(0, self.hidden_size), persistent=False)
+        self.register_buffer("feature_count", torch.zeros((), dtype=torch.long), persistent=False)
+        self.register_buffer("feature_ptr", torch.zeros((), dtype=torch.long), persistent=False)
+
+    def _ensure_storage(self, reference: torch.Tensor) -> bool:
+        if self.max_size <= 1:
+            return False
+        if self.feature_count.device != reference.device:
+            self.feature_count = self.feature_count.to(reference.device)
+            self.feature_ptr = self.feature_ptr.to(reference.device)
+        expected_shape = (self.max_size, self.hidden_size)
+        storage_mismatch = (
+            self.features.device != reference.device
+            or self.features.dtype != reference.dtype
+            or tuple(self.features.shape) != expected_shape
+        )
+        if storage_mismatch:
+            self.features = torch.empty(expected_shape, dtype=reference.dtype, device=reference.device)
+            self.feature_count.zero_()
+            self.feature_ptr.zero_()
+        return True
+
+    @_disable_torch_compile
+    @torch.no_grad()
+    def add(self, features: torch.Tensor) -> None:
+        if not self._ensure_storage(features):
+            return
+        flat = features.detach().reshape(-1, self.hidden_size)
+        if flat.shape[0] == 0:
+            return
+        add_count = flat.shape[0] if self.max_add == 0 else min(self.max_add, flat.shape[0])
+        if flat.shape[0] > add_count:
